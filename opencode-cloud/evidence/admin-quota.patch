@@ -0,0 +1,145 @@
+<!DOCTYPE html>
+<html lang="zh-CN">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>文本统计器</title>
+<style>
+*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
+body {
+  font-family: -apple-system, "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
+  background: #f5f5f5;
+  color: #222;
+  min-height: 100vh;
+  padding: 24px 16px;
+}
+.container {
+  max-width: 600px;
+  margin: 0 auto;
+  background: #fff;
+  border-radius: 12px;
+  padding: 24px 20px;
+  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
+}
+h1 {
+  font-size: 20px;
+  text-align: center;
+  margin-bottom: 20px;
+  color: #333;
+}
+label {
+  display: block;
+  font-size: 14px;
+  font-weight: 600;
+  margin-bottom: 6px;
+  color: #555;
+}
+textarea {
+  width: 100%;
+  height: 160px;
+  padding: 12px;
+  font-size: 15px;
+  border: 1px solid #ddd;
+  border-radius: 8px;
+  resize: vertical;
+  font-family: inherit;
+  line-height: 1.6;
+  background: #fafafa;
+}
+textarea:focus {
+  outline: none;
+  border-color: #888;
+  background: #fff;
+}
+.btn-row {
+  display: flex;
+  gap: 10px;
+  margin-top: 14px;
+}
+button {
+  flex: 1;
+  padding: 10px 0;
+  font-size: 15px;
+  border: none;
+  border-radius: 8px;
+  cursor: pointer;
+  font-weight: 600;
+  transition: background 0.15s;
+}
+#statBtn {
+  background: #333;
+  color: #fff;
+}
+#statBtn:hover { background: #555; }
+#clearBtn {
+  background: #e8e8e8;
+  color: #555;
+}
+#clearBtn:hover { background: #d8d8d8; }
+.result {
+  margin-top: 18px;
+  padding: 16px;
+  background: #fafafa;
+  border-radius: 8px;
+  display: none;
+}
+.result.show { display: block; }
+.result p {
+  font-size: 15px;
+  margin-bottom: 6px;
+}
+.result p:last-child { margin-bottom: 0; }
+.result .num {
+  font-weight: 700;
+  color: #333;
+}
+@media (max-width: 480px) {
+  body { padding: 12px 8px; }
+  .container { padding: 18px 14px; }
+  textarea { height: 140px; font-size: 16px; }
+}
+</style>
+</head>
+<body>
+<div class="container">
+  <h1>文本统计器</h1>
+  <label for="inputText">输入文本</label>
+  <textarea id="inputText" placeholder="在此输入或粘贴文本..."></textarea>
+  <div class="btn-row">
+    <button id="statBtn">统 计</button>
+    <button id="clearBtn">清 空</button>
+  </div>
+  <div class="result" id="result">
+    <p>字符数：<span class="num" id="charCount">0</span></p>
+    <p>单词数：<span class="num" id="wordCount">0</span></p>
+  </div>
+</div>
+<script type="module">
+import { countCharacters, countWords } from './stats.mjs';
+
+const textarea = document.getElementById('inputText');
+const statBtn = document.getElementById('statBtn');
+const clearBtn = document.getElementById('clearBtn');
+const result = document.getElementById('result');
+const charCount = document.getElementById('charCount');
+const wordCount = document.getElementById('wordCount');
+
+statBtn.addEventListener('click', () => {
+  const text = textarea.value;
+  const chars = countCharacters(text);
+  const words = countWords(text);
+  charCount.textContent = chars;
+  wordCount.textContent = words;
+  result.classList.add('show');
+});
+
+clearBtn.addEventListener('click', () => {
+  textarea.value = '';
+  charCount.textContent = '0';
+  wordCount.textContent = '0';
+  result.classList.remove('show');
+  textarea.focus();
+});
+</script>
+</body>
+</html>
diff --git a/web/stats.mjs b/web/stats.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9bc10a330adba2de25242c659fdf02405d521d22
--- /dev/null
+++ b/web/stats.mjs
@@ -0,0 +1,9 @@
+export function countCharacters(text) {
+	return [...text].length;
+}
+
+export function countWords(text) {
+	const trimmed = text.trim();
+	if (trimmed.length === 0) return 0;
+	return trimmed.split(/\s+/).length;
+}
